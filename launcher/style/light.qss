/* Synora Bridge — Stack Launcher · LIGHT extra style.
   qt-material (light_blue.xml) provides the base Material look; this file is
   appended on top for the launcher-specific bits (consoles, roles, dots). */
QLabel#brandLabel {
    font-size: 17px;
    font-weight: 700;
    color: #2563eb;
}
QLabel#subtitleLabel {
    font-size: 12px;
    color: #6b7280;
}
QLabel[role="dot"] {
    font-size: 15px;
}
QLabel#statusDaphne, QLabel#statusWorker, QLabel#statusBeat, QLabel#statusFrontend {
    font-size: 11px;
    font-weight: 600;
    min-width: 80px;
}
QPushButton[role="start"] { background-color: #16a34a; color: #ffffff; }
QPushButton[role="start"]:hover { background-color: #15803d; }
QPushButton[role="stop"] { background-color: #dc2626; color: #ffffff; }
QPushButton[role="stop"]:hover { background-color: #b91c1c; }
QPushButton[role="restart"] { background-color: #2563eb; color: #ffffff; }
QPushButton[role="restart"]:hover { background-color: #1d4ed8; }
QPushButton[role="clear"] {
    background-color: transparent;
    color: #475569;
    border: 1px solid #cbd5e1;
    font-weight: 500;
}
QPushButton[role="clear"]:hover {
    background-color: #f1f5f9;
    color: #1f2937;
}
QPlainTextEdit {
    background-color: #ffffff;
    color: #1f2937;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas;
    font-size: 10pt;
    selection-background-color: #bfdbfe;
}
