/* Synora Bridge — Stack Launcher · DARK extra style.
   qt-material (dark_blue.xml) provides the base Material look; this file is
   appended on top for the launcher-specific bits (consoles, roles, dots). */
QLabel#brandLabel {
    font-size: 17px;
    font-weight: 700;
    color: #60a5fa;
}
QLabel#subtitleLabel {
    font-size: 12px;
    color: #9ca3af;
}
QLabel[role="dot"] {
    font-size: 15px;
}
QLabel#statusDaphne, QLabel#statusWorker, QLabel#statusBeat, QLabel#statusFrontend {
    font-size: 11px;
    font-weight: 600;
    min-width: 80px;
}
QPushButton[role="start"] { background-color: #16a34a; color: #ffffff; }
QPushButton[role="start"]:hover { background-color: #22c55e; }
QPushButton[role="stop"] { background-color: #dc2626; color: #ffffff; }
QPushButton[role="stop"]:hover { background-color: #ef4444; }
QPushButton[role="restart"] { background-color: #2563eb; color: #ffffff; }
QPushButton[role="restart"]:hover { background-color: #3b82f6; }
QPushButton[role="clear"] {
    background-color: transparent;
    color: #9ca3af;
    border: 1px solid #374151;
    font-weight: 500;
}
QPushButton[role="clear"]:hover {
    background-color: #1f2937;
    color: #e5e7eb;
}
QPlainTextEdit {
    background-color: #0b0f19;
    color: #4ade80;
    border: 1px solid #1f2937;
    border-radius: 8px;
    padding: 8px;
    font-family: Consolas;
    font-size: 10pt;
    selection-background-color: #1e3a5f;
}
