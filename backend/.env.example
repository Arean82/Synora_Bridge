# ==========================================================================
# Synora Bridge (Django backend) — environment overrides
#
# PRIMARY CONFIGURATION LIVES IN backend/config.ini — edit that file first.
# The [Server] environment flag selects the database:
#   environment = development → SQLite ([SQLITE] section)
#   environment = production  → PostgreSQL ([POSTGRES] section)
#
# This .env file is optional and only overrides the two secrets below
# (so credentials never have to be written into the shared config.ini).
# ==========================================================================

# Override config.ini [SECURITY] secret_key
DJANGO_SECRET_KEY=

# Override config.ini [SECURITY] encryption_key
ENCRYPTION_KEY=
