openapi: 3.0.3
info:
  title: Synora Bridge API
  version: 1.0.0
  description: 'Universal API bridge: scheduled multi-source push, pull REST with
    dynamic OpenAPI specs, pull GraphQL with a dynamic Strawberry schema, and a Swagger-driven
    mock server.'
paths:
  /api/v1/audit-logs/:
    get:
      operationId: api_v1_audit_logs_list
      description: Read-only audit trail, filterable by mode/template/status.
      parameters:
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      tags:
      - api
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedAuditLogList'
          description: ''
  /api/v1/audit-logs/{id}/:
    get:
      operationId: api_v1_audit_logs_retrieve
      description: Read-only audit trail, filterable by mode/template/status.
      parameters:
      - in: path
        name: id
        schema:
          type: integer
        description: A unique integer value identifying this audit log.
        required: true
      tags:
      - api
      security:
      - cookieAuth: []
      - tokenAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditLog'
          description: ''
